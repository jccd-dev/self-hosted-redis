#!/bin/sh
set -eu

ROOT=$(CDPATH='' cd -- "$(dirname "$0")/.." && pwd)
. "$ROOT/lib/common.sh"

validate_environment
require_secret restic-password
file=$(backup_env_file)

if [ -n "${R2_ACCOUNT_ID:-}${R2_BUCKET:-}" ]; then
    [ -n "${R2_ACCOUNT_ID:-}" ] && [ -n "${R2_BUCKET:-}" ] &&
        [ -n "${AWS_ACCESS_KEY_ID:-}" ] && [ -n "${AWS_SECRET_ACCESS_KEY:-}" ] ||
        die "provide all of R2_ACCOUNT_ID, R2_BUCKET, AWS_ACCESS_KEY_ID, and AWS_SECRET_ACCESS_KEY"
    printf '%s\n' "$R2_ACCOUNT_ID" | grep -Eq '^[0-9a-fA-F]{32}$' || die "R2_ACCOUNT_ID must be a 32-character hexadecimal account ID"
    printf '%s\n' "$R2_BUCKET" | grep -Eq '^[a-z0-9][a-z0-9-]{1,61}[a-z0-9]$' || die "R2_BUCKET must be a valid 3-63 character bucket name"
    printf '%s\n' "$AWS_ACCESS_KEY_ID$AWS_SECRET_ACCESS_KEY" | grep -q '[[:space:]]' && die "R2 credentials must not contain whitespace"

    umask 077
    tmp="$file.tmp"
    {
        printf 'R2_ACCOUNT_ID=%s\n' "$R2_ACCOUNT_ID"
        printf 'R2_BUCKET=%s\n' "$R2_BUCKET"
        printf 'AWS_ACCESS_KEY_ID=%s\n' "$AWS_ACCESS_KEY_ID"
        printf 'AWS_SECRET_ACCESS_KEY=%s\n' "$AWS_SECRET_ACCESS_KEY"
        printf 'AWS_DEFAULT_REGION=auto\n'
        printf 'RESTIC_REPOSITORY=s3:https://%s.r2.cloudflarestorage.com/%s\n' "$R2_ACCOUNT_ID" "$R2_BUCKET"
    } >"$tmp"
    chmod 600 "$tmp"
    mv "$tmp" "$file"
fi

require_backup_config
if restic_run snapshots >/dev/null 2>&1; then
    printf 'Existing Restic repository is accessible.\n'
else
    restic_run init
    printf 'Initialized encrypted Restic repository.\n'
fi
